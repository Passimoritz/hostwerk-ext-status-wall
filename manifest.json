{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "status-wall",
  "name": {
    "de": "Status-Wand",
    "en": "Status Wall"
  },
  "description": {
    "de": "Alle Dienste groß und farbig auf einen Blick – ideal für einen zweiten Bildschirm oder das Tablet an der Wand. Ein Klick startet Gestopptes neu (mit Rückfrage).",
    "en": "All services big and colourful at a glance – ideal for a second screen or a tablet on the wall. One click restarts what stopped (asks first)."
  },
  "version": "1.1.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-status-wall",
  "license": "MIT",
  "icon": "icon.svg",
  "color": "#0ea5e9",
  "hostwerk": ">=2.9.0",
  "permissions": [
    "read:services",
    "control:services"
  ],
  "page": {
    "title": {
      "de": "Status-Wand",
      "en": "Status Wall"
    },
    "icon": "monitor",
    "file": "page/index.html",
    "description": {
      "de": "Alle Dienste groß und farbig auf einen Blick – ideal für einen zweiten Bildschirm oder das Tablet an der Wand. Ein Klick startet Gestopptes neu (mit Rückfrage).",
      "en": "All services big and colourful at a glance – ideal for a second screen or a tablet on the wall. One click restarts what stopped (asks first)."
    }
  },
  "widget": {
    "title": {
      "de": "Dienste",
      "en": "Services"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "settings": [
    {
      "key": "group",
      "type": "switch",
      "label": {
        "de": "Nach Art gruppieren",
        "en": "Group by kind"
      },
      "default": true
    },
    {
      "key": "showStopped",
      "type": "switch",
      "label": {
        "de": "Gestoppte Dienste zeigen",
        "en": "Show stopped services"
      },
      "default": true
    },
    {
      "key": "size",
      "type": "select",
      "label": {
        "de": "Kachelgröße",
        "en": "Tile size"
      },
      "default": "normal",
      "options": [
        {
          "value": "compact",
          "label": {
            "de": "Kompakt",
            "en": "Compact"
          }
        },
        {
          "value": "normal",
          "label": {
            "de": "Normal",
            "en": "Normal"
          }
        },
        {
          "value": "wall",
          "label": {
            "de": "Wand (groß)",
            "en": "Wall (large)"
          }
        }
      ]
    }
  ]
}
