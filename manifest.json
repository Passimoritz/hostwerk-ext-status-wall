{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "status-wall",
  "name": {
    "de": "Status-Wand",
    "en": "Status Wall"
  },
  "description": {
    "de": "Alle Dienste groß und farbig auf einen Blick – auch Spiele-Server, mit Erreichbarkeit und Mini-Verlauf von CPU und Arbeitsspeicher. Ideal für einen zweiten Bildschirm oder das Tablet an der Wand. Starten, Stoppen und Neustarten mit Rückfrage.",
    "en": "All services big and colourful at a glance – game servers included, with reachability and a small CPU and memory history. Ideal for a second screen or a tablet on the wall. Start, stop and restart (asks first)."
  },
  "version": "1.3.0",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-status-wall",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#0ea5e9",
  "category": "monitoring",
  "hostwerk": ">=2.9.0",
  "permissions": [
    "read:services",
    "control:services",
    "read:system",
    "read:live"
  ],
  "page": {
    "title": {
      "de": "Status-Wand",
      "en": "Status Wall"
    },
    "icon": "monitor",
    "file": "page/index.html",
    "description": {
      "de": "Alle Dienste groß und farbig auf einen Blick – auch Spiele-Server, mit Erreichbarkeit und Mini-Verlauf von CPU und Arbeitsspeicher. Ideal für einen zweiten Bildschirm oder das Tablet an der Wand. Starten, Stoppen und Neustarten mit Rückfrage.",
      "en": "All services big and colourful at a glance – game servers included, with reachability and a small CPU and memory history. Ideal for a second screen or a tablet on the wall. Start, stop and restart (asks first)."
    },
    "nav": {
      "group": "monitoring",
      "groupTitle": {
        "de": "Überwachung",
        "en": "Monitoring"
      }
    }
  },
  "widget": {
    "title": {
      "de": "Dienste",
      "en": "Services"
    },
    "file": "widget/index.html",
    "size": "third"
  },
  "settings": [
    {
      "key": "group",
      "type": "switch",
      "label": {
        "de": "Nach Art gruppieren",
        "en": "Group by kind"
      },
      "default": true
    },
    {
      "key": "showStopped",
      "type": "switch",
      "label": {
        "de": "Gestoppte Dienste zeigen",
        "en": "Show stopped services"
      },
      "default": true
    },
    {
      "key": "size",
      "type": "select",
      "label": {
        "de": "Kachelgröße",
        "en": "Tile size"
      },
      "default": "normal",
      "options": [
        {
          "value": "compact",
          "label": {
            "de": "Kompakt",
            "en": "Compact"
          }
        },
        {
          "value": "normal",
          "label": {
            "de": "Normal",
            "en": "Normal"
          }
        },
        {
          "value": "wall",
          "label": {
            "de": "Wand (groß)",
            "en": "Wall (large)"
          }
        }
      ]
    }
  ],
  "contributes": {
    "shortcuts": [
      {
        "id": "open",
        "title": {
          "de": "Status-Wand öffnen",
          "en": "Open status wall"
        },
        "keys": "ctrl+alt+w"
      }
    ]
  },
  "allowExtensions": {
    "*": [
      "tabs"
    ]
  }
}
